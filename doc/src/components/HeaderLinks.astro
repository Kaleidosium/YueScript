---
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";

const tryHref = `${Astro.locals.starlightRoute.siteTitleHref}try/`;
---

<a class="try-link" href={tryHref}>
  {Astro.locals.t("yue.try")}
</a>
<SocialIcons />

<style>
  .try-link {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.5em;
    outline-offset: 0.25rem;
  }
  .try-link:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
</style>
